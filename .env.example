# Example environment configuration for Robinson Crusoe API
# Copy this file to .env and adjust values as needed

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# CORS Settings (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-frontend-domain.com

# Model Settings
MODEL_PATH=/home/user/An-Adaptive-Methodology/models/final_model.keras

# Text Processing
MIN_TEXT_LENGTH=50
MAX_TEXT_LENGTH=1000000
MAX_BATCH_SIZE=100

# Cache Settings
CACHE_EMBEDDINGS=true
EMBEDDINGS_CACHE_PATH=/home/user/An-Adaptive-Methodology/data/cache

# Logging
LOG_LEVEL=INFO
